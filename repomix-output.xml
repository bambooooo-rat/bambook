            gap: 20px;
            flex-shrink: 0; 
        }

        .daw-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-title {
            font-size: 1.3rem;
            margin: 0;
            color: var(--color-header-blue);
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        /* --- 載入音軌下拉選單 --- */
        .audio-dropdown-container {
            position: relative;
            display: inline-block;
        }

        .upload-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            background: var(--bg-light-gray);
            border: 1px solid var(--border-color);
