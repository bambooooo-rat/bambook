    border: 1px solid #cbd5e1;
    touch-action: none; /* 旋鈕保持阻擋原生的滾動行為 */
}

.knob-base:active { cursor: grabbing; }

.knob-dial {
    width: 100%;
    height: 100%;
    border-radius: 50%;
