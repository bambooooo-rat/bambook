<file path="assets/css/style.css">
/* assets/css/style.css */

:root {
    /* --- 色彩系統 --- */
    --bg-body: #f0f2f5;
    --bg-white: #ffffff;
    --bg-light-gray: #f7f9fa;
    --bg-hover: #f1f1f1;
    
    --text-primary: #333333;
    --text-title: #1a1a1a;
    --text-secondary: #555555;
    --text-muted: #888888;
    
    --border-color: #e1e4e8;
    
    --color-accent: #2196f3;
    --color-header-blue: #2c3e50;
    --color-accent-red: #d9534f;

    --shadow-card: 0 4px 12px rgba(0,0,0,0.08);
    --shadow-hover: 0 6px 16px rgba(0,0,0,0.12);
}

*, *::before, *::after { box-sizing: border-box; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-main);
    background-color: var(--bg-body);
    color: var(--text-primary);
    line-height: 1.6;
    /* 開啟 iOS 慣性捲動 */
    -webkit-overflow-scrolling: touch;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px;
}

/* --- Header --- */
.header-card {
    background: var(--bg-white);
    padding: 12px 20px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    margin-bottom: 25px;
    border: 1px solid var(--border-color);
    position: sticky;
    top: 15px;
    z-index: 100;
    
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px 30px;

    /* GPU 加速提示，優化 Sticky 效果 */
    will-change: transform;
    transform: translateZ(0); 
}

.header-title {
    font-size: 1.1rem;
    margin: 0;
    color: var(--text-secondary);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    opacity: 0.8;
}

.header-title:hover {
    opacity: 1;
    color: var(--color-accent);
    cursor: default;
    transition: 0.2s;
}

.semester-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    border: none;
    margin: 0;
    flex-grow: 1;
    justify-content: flex-end;
}

.nav-btn {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-family: var(--font-main);
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 5px;
    touch-action: manipulation;
}

.nav-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.nav-btn.active {
    background: var(--bg-active, #e3f2fd);
    color: var(--color-accent);
    border-color: rgba(33, 150, 243, 0.2);
    box-shadow: none;
    transform: none;
}

@media (max-width: 600px) {
    .header-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
    .semester-nav {
        width: 100%;
        justify-content: flex-start;
        overflow-x: auto;
        padding-bottom: 5px;
        scrollbar-width: none; 
    }
    .semester-nav::-webkit-scrollbar { display: none; }
}

/* --- Content Cards --- */
.content-card {
    background: var(--bg-white);
    padding: 25px;
    border-radius: 12px;
    box-shadow: var(--shadow-card);
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
    animation: fadeIn 0.3s ease-out;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
}

.card-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin-bottom: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* --- List Items --- */
.resource-list { list-style: none; padding: 0; margin: 0; }

.resource-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 15px;
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.2s;
    border-radius: 6px;
}
.resource-item:last-child { border-bottom: none; }
.resource-item:hover { background-color: #fcfcfc; }

.item-info { display: flex; flex-direction: column; }
.item-title { font-weight: 600; color: var(--text-title); font-size: 1.05rem; }
.item-meta { font-size: 0.85rem; color: var(--text-muted); margin-top: 2px; }

/* --- Buttons --- */
.action-group { display: flex; gap: 8px; }

.btn {
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 1px solid transparent;
}

.btn-primary { background: #e3f2fd; color: #1976d2; border: 1px solid #bbdefb; }
.btn-primary:hover { background: #bbdefb; }

.btn-sol { background: #e3f2fd; color: #1976d2; border: 1px solid #bbdefb; }
.btn-sol:hover { background: #bbdefb; }

.btn-blank { background: #fff8e1; color: #f57f17; border: 1px solid #ffecb3; }
.btn-blank:hover { background: #ffecb3; }

/* Grid Layouts */
.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 15px;
}

.textbook-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
}

.grid-item {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 15px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
}
.grid-item:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
    border-color: var(--color-accent);
}

/* Compact Grid (Slides) */
.slides-container { margin-bottom: 20px; }
.grid-compact {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); 
    gap: 10px;
}
.grid-item-compact {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.2s;
    text-decoration: none;
    color: var(--text-primary);
    height: 100%;
}
.grid-item-compact:hover {
    border-color: var(--color-accent);
    background: #f8fbff;
    transform: translateY(-2px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.grid-icon-compact { font-size: 1.5rem; margin-bottom: 5px; }
.grid-title-compact { font-size: 0.85rem; line-height: 1.3; word-break: break-word; }

/* Practice Compact List */
.practice-grid-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
    gap: 10px 20px;
}
.practice-item-compact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: 1px solid #eee;
    background: #fff;
    border-radius: 4px;
}
.practice-item-compact:hover { background-color: #f9f9f9; }

/* Accordion */
.slide-accordion-group {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.2s;
    transform: translate3d(0, 0, 0);
}

.slide-accordion-header {
    padding: 15px;
    background: #fcfcfc;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    border-left: 4px solid var(--color-header-blue);
    -webkit-tap-highlight-color: transparent;
