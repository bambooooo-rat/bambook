:root {
    --font-main: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

    /* --- 色彩系統 --- */
    --bg-body: #f0f2f5;
    --bg-white: #ffffff;
    --bg-light-gray: #f7f9fa;
    --bg-hover: #f1f1f1;
    
    --text-primary: #333333;
    --text-title: #1a1a1a;
    --text-secondary: #555555;
    --text-muted: #888888;
    
    --border-color: #e1e4e8;
    
    --color-accent: #2196f3;
    --color-header-blue: #2c3e50;
    --color-accent-red: #d9534f;

    --shadow-card: 0 4px 12px rgba(0,0,0,0.08);
    --shadow-hover: 0 6px 16px rgba(0,0,0,0.12);
}

*, *::before, *::after { box-sizing: border-box; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-main);
    background-color: var(--bg-body);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    height: 100vh; /* 桌面端鎖定高度 */
    overflow: hidden; /* 桌面端無捲軸 */
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
}

.allow-select { user-select: text; }

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0; 
}

/* --- Content Cards --- */
.content-card {
    background: var(--bg-white);
    border-radius: 12px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border-color);
    flex: 1; 
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

/* --- 專業版頂部控制列 (DAW Transport Bar) --- */
.daw-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 25px;
    background: var(--bg-white);
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
    gap: 20px;
    flex-shrink: 0; 
}

.daw-left {
    display: flex;
    align-items: center;
    gap: 20px;
}

.header-title {
    font-size: 1.3rem;
    margin: 0;
    color: var(--color-header-blue);
    font-weight: 800;
    letter-spacing: 0.5px;
}

/* --- 載入音軌下拉選單 --- */
.audio-dropdown-container {
    position: relative;
    display: inline-block;
}

.upload-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: var(--bg-light-gray);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
}

.upload-btn:hover {
    background: var(--bg-hover);
    color: var(--color-accent);
    border-color: var(--color-accent);
}

.audio-dropdown-list {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 8px;
    background: var(--bg-white);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    box-shadow: var(--shadow-hover);
    min-width: 220px;
    max-height: 300px;
    overflow-y: auto;
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s;
}

.audio-dropdown-container.open .audio-dropdown-list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.audio-dropdown-item {
    padding: 10px 15px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.audio-dropdown-item:hover {
    background: var(--bg-hover);
    color: var(--color-accent);
}

.audio-dropdown-divider {
    height: 1px;
    background: var(--border-color);
    margin: 4px 0;
}

.daw-center {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
    max-width: 600px;
    min-width: 250px;
}

.play-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-accent);
    color: white;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.1s, background 0.2s, box-shadow 0.2s;
