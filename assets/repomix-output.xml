<file path="css/site.css">
:root {
  color-scheme: light;
  --bg: #f7f8f8;
  --surface: #ffffff;
  --surface-soft: #f1f5f4;
  --text: #17221f;
  --muted: #62716b;
  --border: #dce6e2;
  --accent: #0d9488;
  --accent-strong: #0f766e;
  --accent-soft: #d9f4ef;
  --danger: #b42318;
  --shadow: 0 16px 42px rgba(19, 45, 38, .08);
  --radius: 16px;
  --markdown-landscape-image-height: 18rem;
  --markdown-portrait-image-width: 18rem;
  --markdown-square-image-width: 20rem;
  --font-sans: "Noto Sans TC", "Noto Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "Noto Sans Mono", ui-monospace, SFMono-Regular, Consolas, monospace;
}

html[data-theme="dark"] {
  color-scheme: dark;
  --bg: #101816;
  --surface: #18221f;
  --surface-soft: #202e29;
  --text: #e8f1ed;
  --muted: #a6b6af;
  --border: #31433c;
  --accent: #40c8b8;
  --accent-strong: #7ee4d7;
  --accent-soft: #164b44;
  --danger: #ffaaa2;
  --shadow: 0 16px 42px rgba(0, 0, 0, .24);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scrollbar-gutter: stable; }
.article-list::-webkit-scrollbar,
.article-toc::-webkit-scrollbar,
.article-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
.article-list::-webkit-scrollbar-track,
.article-toc::-webkit-scrollbar-track,
.article-scroll::-webkit-scrollbar-track { background: transparent; }
.article-list::-webkit-scrollbar-thumb,
.article-toc::-webkit-scrollbar-thumb,
.article-scroll::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
body {
  min-height: 100vh;
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  line-height: 1.65;
  -webkit-user-select: none;
  user-select: none;
}
a { color: inherit; }
button, input { font: inherit; }
button { color: inherit; }
input, textarea, select, [contenteditable="true"], [contenteditable="true"] * {
  -webkit-user-select: text;
  user-select: text;
}

.skip-link {
  position: fixed; left: 1rem; top: -4rem; z-index: 100;
  padding: .6rem .9rem; border-radius: 8px; background: var(--accent); color: white;
}
.skip-link:focus { top: 1rem; }

.site-header {
  position: sticky; top: 0; z-index: 30;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 86%, transparent);
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter: blur(14px);
}
.header-inner {
  display: flex; align-items: center; gap: 1rem; width: min(1240px, calc(100% - 2.5rem)); max-width: none;
  min-height: 4.5rem; margin: 0 auto; padding: .65rem 0rem;
}
.brand { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .55rem; color: var(--text); font-size: 1.2rem; font-weight: 800; letter-spacing: -.03em; text-decoration: none; }
.brand svg { width: 1.55rem; color: var(--accent); }
.main-nav { display: flex; align-items: center; gap: .2rem; }
.main-nav > a, .nav-menu > button {
  display: inline-flex; align-items: center; gap: .25rem; min-height: 2.4rem; padding: .45rem .75rem;
  border: 0; border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; font-weight: 650; text-decoration: none;
}
.main-nav > a:hover, .main-nav > a.is-active, .nav-menu > button:hover, .nav-menu > button[aria-expanded="true"] { background: var(--accent-soft); color: var(--accent-strong); }
.nav-menu { position: relative; }
.nav-chevron { width: .9rem; height: .9rem; transition: transform .2s ease; }
.nav-menu > button[aria-expanded="true"] .nav-chevron { transform: rotate(180deg); }
.menu-panel {
  position: absolute; top: calc(100% + .35rem); left: 0; display: grid; width: max-content; min-width: 11.5rem;
  padding: .4rem; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow);
  opacity: 0; pointer-events: none; transform: translateY(-.45rem) scale(.98); transform-origin: top left;
  transition: opacity .18s ease, transform .18s ease, visibility .18s ease; visibility: hidden;
}
.nav-menu.is-open .menu-panel { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); visibility: visible; }
.menu-panel a { padding: .55rem .7rem; border-radius: 8px; color: var(--muted); font-size: .94rem; text-decoration: none; white-space: nowrap; }
.menu-panel a:hover { background: var(--surface-soft); color: var(--accent-strong); }
.menu-panel-wide { min-width: 13rem; }
.icon-button { margin-left: auto; display: grid; width: 2.45rem; height: 2.45rem; place-items: center; border: 1px solid transparent; border-radius: 10px; background: transparent; color: var(--muted); cursor: pointer; }
.icon-button:hover { border-color: var(--border); background: var(--surface); color: var(--accent-strong); }
.icon-button svg { width: 1.2rem; }
.theme-icon-moon { display: none; }
html[data-theme="dark"] .theme-icon-sun { display: none; }
html[data-theme="dark"] .theme-icon-moon { display: block; }

.page-shell { width: min(1240px, calc(100% - 2.5rem)); min-height: calc(100vh - 8rem); margin: 0 auto; padding: 3.5rem 0 4rem; }
.hero { position: relative; display: block; margin-bottom: 2.7rem; padding: 1rem 0 3rem; border-bottom: 1px solid var(--border); }
.hero::after { position: absolute; bottom: -1px; left: 0; width: min(18rem, 40%); height: 3px; border-radius: 3px; background: var(--accent); content: ""; }
.eyebrow { margin: 0 0 .7rem; color: var(--accent-strong); font-family: var(--font-mono); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
h1, h2, h3, p { margin-top: 0; }
.hero h1, .page-heading h1 { margin-bottom: 0; font-size: clamp(2.2rem, 6vw, 4.7rem); line-height: 1.08; letter-spacing: -.055em; }
.home-intro {
  position: relative;
  margin-bottom: 2.6rem;
  padding: clamp(1.15rem, 3vw, 1.65rem);
  border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
  border-radius: var(--radius);
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--accent-soft) 68%, transparent), transparent 58%),
    var(--surface);
  box-shadow: var(--shadow);
}
.home-intro::before {
  position: absolute;
  inset: 1rem auto 1rem 0;
  width: 4px;
  border-radius: 0 4px 4px 0;
  background: var(--accent);
  content: "";
}
.home-intro, .home-intro * { -webkit-user-select: none; user-select: none; }
.home-intro-label { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .85rem; padding-left: .55rem; color: var(--accent-strong); font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.home-intro-label span { padding: .16rem .5rem; border-radius: 999px; background: color-mix(in srgb, var(--accent-soft) 70%, white); }
.home-intro-body { max-width: 58rem; padding-left: .55rem; }
.home-intro-body h1 { margin: 0 0 .8rem; font-size: clamp(1.45rem, 3vw, 2rem); line-height: 1.22; letter-spacing: -.035em; }
.home-intro-body h2 { margin: 1.35rem 0 .55rem; font-size: 1.1rem; letter-spacing: -.02em; }
.home-intro-body p { margin-bottom: .85rem; color: color-mix(in srgb, var(--text) 90%, var(--muted)); }
.home-intro-body ul { margin: .3rem 0 .9rem; padding-left: 1.25rem; }
.home-intro-body li { margin: .2rem 0; color: color-mix(in srgb, var(--text) 88%, var(--muted)); }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 2.75rem 0 1rem; }
.section-heading h2 { margin: 0; font-size: 1.25rem; letter-spacing: -.02em; }
.section-heading a, .inline-link { color: var(--accent-strong); font-size: .9rem; font-weight: 700; text-decoration: none; }
.section-heading a:hover, .inline-link:hover { text-decoration: underline; }

.card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
.card {
  display: flex; flex-direction: column; min-height: 13rem; padding: 1.35rem; border: 1px solid var(--border); border-radius: var(--radius);
  background: var(--surface); box-shadow: 0 4px 15px rgba(19, 45, 38, .035); text-decoration: none; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}
.card:hover { border-color: var(--accent); box-shadow: var(--shadow); transform: translateY(-3px); }
.card-icon { display: grid; width: 2.55rem; height: 2.55rem; place-items: center; margin-bottom: 1.5rem; border-radius: 10px; background: var(--accent-soft); color: var(--accent-strong); font-size: 1.25rem; }
.card h3 { margin-bottom: .45rem; font-size: 1.08rem; }
.card p { margin-bottom: 1.2rem; color: var(--muted); font-size: .94rem; }
.card .card-action { margin-top: auto; color: var(--accent-strong); font-size: .9rem; font-weight: 750; }
.tool-card { min-height: 15rem; }
.card-icon .ui-icon { width: 1.35rem; height: 1.35rem; }
.card .card-action { display: inline-flex; align-items: center; gap: .3rem; }
.card .card-action .ui-icon { width: .95rem; height: .95rem; }
.tag-list { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: 1.15rem; }
.tag { padding: .14rem .5rem; border-radius: 999px; background: var(--surface-soft); color: var(--muted); font-size: .74rem; font-weight: 650; }

.page-heading { max-width: 48rem; margin-bottom: 2.4rem; }
.page-heading h1 { font-size: clamp(2rem, 5vw, 3.3rem); }
.page-heading p { color: var(--muted); font-size: 1.05rem; }
.back-link { display: inline-flex; align-items: center; gap: .35rem; margin-bottom: 1.4rem; color: var(--accent-strong); font-size: .92rem; font-weight: 700; text-decoration: none; }
.back-link:hover { text-decoration: underline; }

.course-layout { display: grid; grid-template-columns: minmax(0, 1fr) 15.5rem; gap: 2rem; align-items: start; }
.course-content { min-width: 0; }
.course-sidebar { position: sticky; top: 6rem; padding: .65rem; border: 1px solid var(--border); border-radius: 13px; background: var(--surface); }
.course-sidebar h2 { margin: .35rem .5rem .65rem; color: var(--muted); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
.course-sidebar a { display: block; padding: .55rem .6rem; border-radius: 8px; color: var(--muted); font-size: .93rem; text-decoration: none; }
.course-sidebar a:hover, .course-sidebar a.is-active { background: var(--accent-soft); color: var(--accent-strong); font-weight: 700; }
.resource-section { margin-bottom: 1.15rem; padding: 1.35rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
.resource-section h2 { display: flex; align-items: center; gap: .55rem; margin-bottom: 1.1rem; font-size: 1.15rem; }
.resource-section h2 .ui-icon { width: 1.15rem; height: 1.15rem; color: var(--accent-strong); }
.resource-grid { display: block; }
.resource-item { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem; padding: .85rem 0; border-top: 1px solid var(--border); }
.resource-grid > .resource-item:first-child { padding-top: 0; border-top: 0; }
.resource-name { min-width: 0; font-size: .92rem; font-weight: 650; overflow-wrap: anywhere; }
.resource-meta { margin-top: .15rem; color: var(--muted); font-size: .8rem; }
.resource-link { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .35rem; padding: .4rem .6rem; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); color: var(--accent-strong); font-size: .84rem; font-weight: 700; text-decoration: none; }
.resource-link:hover { border-color: var(--accent); background: var(--accent-soft); }
.resource-link .ui-icon { width: .95rem; height: .95rem; }
.resource-document-link { display: inline-flex; align-items: center; gap: .45rem; margin: -.35rem; padding: .35rem; border-radius: 7px; color: var(--text); font: inherit; text-decoration: none; transition: background .18s ease, color .18s ease; }
.resource-document-link:hover { background: var(--accent-soft); color: var(--accent-strong); }
.resource-document-link .ui-icon { width: 1.3rem; height: 1.3rem; flex: 0 0 auto; color: var(--accent-strong); }
details.resource-details { border-top: 1px solid var(--border); }
details.resource-details:first-of-type { border-top: 0; }
details.resource-details summary { padding: .85rem 0; cursor: pointer; font-weight: 700; }
details.resource-details[open] { padding-bottom: .55rem; }
details.resource-details[open] .resource-grid {
  margin: .15rem 0 .45rem;
  padding: .25rem 0 .25rem 1rem;
  border-left: 2px solid var(--border);
  background: linear-gradient(90deg, color-mix(in srgb, var(--surface-soft) 72%, transparent), transparent 72%);
}
details.resource-details[open] .resource-item { padding-left: .35rem; }
.syllabus-list { margin: 0; padding-left: 1.15rem; color: var(--muted); }

.article-mode {
  height: 100vh;
  overflow: hidden;
}
.article-mode .page-shell {
  width: min(1240px, calc(100% - 2.5rem));
  height: calc(100vh - 4.5rem);
  min-height: 0;
  padding: 1rem 0 0;
  overflow: hidden;
}
.article-mode .site-footer { display: none; }
.article-reader { height: 100%; min-height: 0; }
.articles-layout {
  display: grid;
  grid-template-columns: minmax(13rem, .85fr) minmax(0, 2.4fr) minmax(12rem, .75fr);
  gap: 2rem;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}
.article-list, .article-toc {
  position: static;
  width: auto;
  max-height: none;
}

.article-list h2 { margin-bottom: .75rem; color: var(--muted); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }

/* === Article index panel: Bamboo-style scroll container === */

.article-list {
  min-height: 0;
  padding-right: 1.25rem;
  border-right: 1px solid var(--border);
}

.article-list,
.article-panel-scroll {
  scrollbar-gutter: stable;
}

.article-list,
.article-panel-scroll,
.article-scroll {
  height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: #d1d5db transparent;
}

.article-list::-webkit-scrollbar,
.article-panel-scroll::-webkit-scrollbar,
.article-scroll::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

.article-list::-webkit-scrollbar-track,
.article-panel-scroll::-webkit-scrollbar-track,
.article-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.article-list::-webkit-scrollbar-thumb,
.article-panel-scroll::-webkit-scrollbar-thumb,
.article-scroll::-webkit-scrollbar-thumb {
  background: #d1d5db;
  border-radius: 4px;
}

/* === Bamboo-style article index === */

.sidebar-index-toggle {
  width: calc(100% - 1rem);
  margin: 0 .5rem .75rem;
  padding: .42rem .55rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: .72rem;
  font-weight: 750;
  letter-spacing: .02em;
}

.sidebar-index-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .35rem;
}

.sidebar-index-toggle::before {
  content: "↕";
  font-size: .8rem;
  color: var(--muted);
}

.sidebar-index-toggle:hover {
  background: var(--accent-soft);
  color: var(--accent-strong);
}

.sidebar-index-toggle:hover::before {
  color: var(--accent-strong);
}

.article-month {
  margin: 0 0 1rem;
}

.article-month + .article-month {
  margin-top: 1.15rem;
}

.article-month > h3 {
  margin: .75rem .75rem .45rem;
  color: var(--text);
  font-size: .78rem;
  font-weight: 850;
  letter-spacing: .03em;
}

.sidebar-month-group {
  margin: .45rem 0 .75rem;
}

.sidebar-month-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
  margin: .55rem .65rem .3rem;
  padding: 0;
  border: 0;
  color: var(--muted);
  cursor: pointer;
  font-family: var(--font-mono);
  font-size: .68rem;
  font-weight: 800;
  letter-spacing: .04em;
  list-style: none;
}

.sidebar-month-label::-webkit-details-marker {
  display: none;
}

.sidebar-month-label::before {
  content: "▾";
  margin-right: .35rem;
  color: var(--muted);
  font-size: .7rem;
}

.sidebar-month-group:not([open]) .sidebar-month-label::before {
  content: "▸";
}

.sidebar-month-label span {
  flex: 1;
}

.sidebar-month-label small {
  color: var(--muted);
  font-size: .64rem;
}

.sidebar-month-items {
  margin-left: 1rem;
  padding-left: .65rem;
  border-left: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
}

.sidebar-link {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: .45rem;
  margin: .12rem .45rem .12rem 0;
  padding: .42rem .55rem;
  border: 0;
  border-radius: 8px;
  background: transparent;
  box-shadow: none;
  color: var(--muted);
  text-decoration: none;
  font-size: .82rem;
  line-height: 1.35;
}

.sidebar-link span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-link:hover {
  background: color-mix(in srgb, var(--surface-soft) 76%, transparent);
  color: var(--text);
}

.sidebar-link.is-active {
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-weight: 760;
}

.sidebar-link small {
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: .65rem;
  font-weight: 800;
}

.sidebar-month-items {
  opacity: 1;
  transform: translateY(0);
  transition: opacity .16s ease, transform .16s ease;
}

.sidebar-month-group:not([open]) .sidebar-month-items {
  opacity: 0;
  transform: translateY(-3px);
}

@supports selector(::details-content) {
  .sidebar-month-group::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size .18s ease,
      content-visibility .18s allow-discrete;
  }

  .sidebar-month-group[open]::details-content {
    block-size: auto;
  }
}

.article-scroll {
  min-width: 0;
  height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding-right: .25rem;
  background: transparent;
}
.article { min-width: 0; padding: 0 0 2rem; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.article-toc {
  height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  padding-left: 1.25rem;
  border-left: 1px solid var(--border);
}
.article-toc h2 { margin-bottom: .75rem; color: var(--muted); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
.toc-nav { display: grid; gap: .15rem; }
.toc-link { display: block; width: 100%; padding: .42rem .55rem; border: 0; border-left: 2px solid transparent; border-radius: 0 8px 8px 0; background: transparent; color: var(--muted); cursor: pointer; font: inherit; font-size: .86rem; line-height: 1.35; text-align: left; transition: background .18s ease, border-color .18s ease, color .18s ease; }
.toc-link:hover { background: var(--surface-soft); color: var(--text); }
.toc-link.is-active { border-left-color: var(--accent); background: var(--accent-soft); color: var(--accent-strong); font-weight: 800; }
.toc-link--h3 { padding-left: 1rem; font-size: .82rem; }
.toc-link--h4 { padding-left: 1.45rem; font-size: .8rem; }
.toc-link--h5, .toc-link--h6 { padding-left: 1.85rem; font-size: .78rem; }
.toc-empty {
  margin: 0;
  padding: .65rem .75rem;
  border: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
  border-radius: 9px;
  background: color-mix(in srgb, var(--surface-soft) 62%, transparent);
  color: color-mix(in srgb, var(--muted) 78%, transparent);
  font-size: .86rem;
}
.article, .article * { -webkit-user-select: text; user-select: text; }
.article-header { padding-bottom: 1.55rem; border-bottom: 1px solid var(--border); }
.article-header h1 { margin: .6rem 0 .7rem; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.15; letter-spacing: -.04em; }
.article-date { color: var(--muted); font-family: var(--font-mono); font-size: .82rem; }
.article-summary { margin: 0; color: var(--muted); }
.article-body { padding-top: 2rem; overflow-wrap: anywhere; }
.article-body h1, .article-body h2, .article-body h3, .article-body h4, .article-body h5, .article-body h6 { margin: 2.15rem 0 .75rem; line-height: 1.25; letter-spacing: -.025em; }
.article-body h1:first-child, .article-body h2:first-child { margin-top: 0; }
.article-body h2 { font-size: 1.45rem; }
.article-body h3 { font-size: 1.15rem; }
.article-body h4 { font-size: 1rem; }
.article-body h5, .article-body h6 { color: var(--muted); font-size: .92rem; }
.article-body p, .article-body li { color: color-mix(in srgb, var(--text) 88%, var(--muted)); }
.article-body a { color: var(--accent-strong); }
.article-body code { padding: .1rem .32rem; border-radius: 5px; background: var(--surface-soft); font-family: var(--font-mono); font-size: .88em; }
.article-body pre { overflow-x: auto; padding: 1rem; border-radius: 10px; background: #15201d; color: #e8f1ed; }
.article-body pre code { padding: 0; background: transparent; }
.article-body blockquote { margin: 1rem 0; padding: .25rem 1rem; border-left: 3px solid var(--accent); color: var(--muted); }
.article-body .math-block, .home-intro-body .math-block,
.article-body .katex-display, .home-intro-body .katex-display {
  display: block;
  width: 100%;
  margin: 1.35rem auto;
  overflow-x: auto;
  overflow-y: hidden;
  text-align: center !important;
}
.article-body .math-block > span, .home-intro-body .math-block > span { display: block; width: 100%; text-align: center !important; }
.article-body .math-block .katex-display, .home-intro-body .math-block .katex-display { margin: 0 auto; }
.article-body .katex-display > .katex, .home-intro-body .katex-display > .katex { display: inline-block; text-align: initial; }
.article-body .math-block > .katex, .home-intro-body .math-block > .katex,
.article-body .math-block > span > .katex, .home-intro-body .math-block > span > .katex { display: inline-block; text-align: initial; }
.article-body img, .home-intro-body img { display: block; max-width: 100%; height: auto; margin: 1.15rem auto; border-radius: 10px; object-fit: contain; }
.article-body img[data-orientation="landscape"], .home-intro-body img[data-orientation="landscape"] {
  width: 100%;
  max-height: min(var(--markdown-landscape-image-height), 55vh);
  height: auto;
}
.article-body img[data-orientation="portrait"], .home-intro-body img[data-orientation="portrait"] {
  width: min(var(--markdown-portrait-image-width), 82%);
  height: auto;
  max-height: 72vh;
}
.article-body img[data-orientation="square"], .home-intro-body img[data-orientation="square"] {
  width: min(var(--markdown-square-image-width), 82%);
  height: auto;
}
.article-body hr { height: 1px; margin: 2rem 0; border: 0; background: var(--border); }
.article-body ul, .article-body ol { padding-left: 1.45rem; }
.article-body li + li { margin-top: .25rem; }
.article-body li > ul, .article-body li > ol { margin-top: .3rem; }
.article-body table { display: block; max-width: 100%; margin: 1.25rem 0; overflow-x: auto; border-collapse: collapse; font-size: .94rem; }
.article-body th, .article-body td { padding: .65rem .8rem; border: 1px solid var(--border); vertical-align: top; }
.article-body th { background: var(--surface-soft); color: var(--text); font-weight: 800; }
.article-body tbody tr:nth-child(even) { background: color-mix(in srgb, var(--surface-soft) 54%, transparent); }
.article-body mark { padding: .05rem .22rem; border-radius: 4px; background: #fff1a8; color: #5b4a00; }
.article-body ins { color: var(--accent-strong); text-decoration-thickness: .08em; text-underline-offset: .18em; }
.article-body abbr[title] { cursor: help; text-decoration: underline dotted; text-underline-offset: .18em; }
.article-body kbd { padding: .12rem .35rem; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 5px; background: var(--surface-soft); font-family: var(--font-mono); font-size: .82em; }
.article-body sub, .article-body sup { line-height: 0; }
.article-body dl { margin: 1.1rem 0; }
.article-body dt { color: var(--text); font-weight: 800; }
.article-body dd { margin: .25rem 0 .85rem 1.25rem; color: var(--muted); }
.article-body .task-list-item { list-style: none; }
.article-body .task-list-item input { width: 1rem; height: 1rem; margin: 0 .45rem 0 -1.35rem; vertical-align: -.14rem; accent-color: var(--accent); }
.article-body .footnotes { margin-top: 2.3rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .9rem; }
.article-body .footnotes p { margin-bottom: .35rem; }
.article-body .footnote-ref, .article-body .footnote-backref { text-decoration: none; }
.article-body details { margin: 1rem 0; padding: .9rem 1rem; border: 1px solid var(--border); border-radius: 10px; background: var(--surface-soft); }
.article-body summary { cursor: pointer; font-weight: 800; }

.empty-state { padding: 1.35rem; border: 1px dashed var(--border); border-radius: 12px; color: var(--muted); text-align: center; }
.notice { padding: .8rem 1rem; border-left: 3px solid var(--accent); border-radius: 8px; background: var(--accent-soft); color: var(--text); font-size: .93rem; }
.error { color: var(--danger); }
.site-footer { width: 100%; margin: 0; padding: 2rem 0 2.5rem; border-top: 1px solid color-mix(in srgb, var(--border) 86%, transparent); color: var(--muted); font-size: .8rem; line-height: 1.75; }
.site-footer > * { width: min(1240px, calc(100% - 2.5rem)); margin-right: auto; margin-left: auto; }
.site-footer a { color: var(--muted); }
.site-footer a:hover { color: var(--accent-strong); }
.footer-contact { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .85rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); color: var(--muted); }
.footer-contact strong { color: var(--text); font-size: .95rem; }
.legal-disclaimer { max-width: 74rem; padding-top: 1rem; }
.legal-disclaimer p { margin: 0 0 .7rem; }

/* Resource pages use section panels and compact rows, not a card per file. */
.resource-section { box-shadow: none; }
.resource-actions { display: flex; flex: 0 0 auto; gap: .6rem; align-items: center; }
.resource-link--icon { width: 3.1rem; height: 3.1rem; justify-content: center; padding: 0; }
.resource-link.resource-link--icon .ui-icon { width: 2rem; height: 2rem; }
.resource-link--handout { width: 5rem; height: 2.4rem; justify-content: center; gap: .1rem; padding: 0; }
.resource-link.resource-link--handout .ui-icon { width: 1.15rem; height: 1.15rem; opacity: 1; }
.resource-link--blank { border-color: #dfcfaf; background: #fcf8ef; color: #84693d; }
.resource-link--blank:hover { border-color: #c9ae78; background: #f8f0df; }
.resource-link--sol { border-color: #bfd7ca; background: #f1f8f4; color: #39715d; }
.resource-link--sol:hover { border-color: #91bba7; background: #e4f1e9; }
.article-overview { max-width: 58rem; }
.article-overview-list { border-top: 1px solid var(--border); }
.article-overview-month { padding: 1.1rem 0 0; }
.article-overview-month > h2 { margin: 0 0 .25rem; color: var(--muted); font-size: .85rem; letter-spacing: .06em; }
.article-overview-item { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--border); text-decoration: none; }
.article-overview-item:hover h2 { color: var(--accent-strong); }
.article-overview-item time { color: var(--muted); font-family: var(--font-mono); font-size: .78rem; }
.article-overview-item h2 { margin: 0 0 .35rem; font-size: 1.15rem; transition: color .18s ease; }
.article-overview-item p { margin: 0; color: var(--muted); font-size: .92rem; }

@media (max-width: 1100px) {
  .article-mode .articles-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .article-mode .article-list,
  .article-mode .article-toc { display: none; }
  .article-mode .article-scroll {
    height: 100%;
    margin: 0;
    overflow-y: auto;
  }
}

@media (max-width: 760px) {
  .header-inner { flex-wrap: wrap; gap: .3rem .65rem; width: min(100% - 1.5rem, 1240px); padding: 1.6rem 0; }
  .brand { margin-right: auto; }
  .icon-button { margin-left: 0; }
  .main-nav { order: 3; width: 100%; overflow-x: auto; padding-bottom: .15rem; }
  .main-nav > a, .nav-menu > button { padding-inline: .6rem; font-size: .9rem; }
  .menu-panel { position: fixed; left: 1rem; right: 1rem; top: 7.75rem; width: auto; }
  .page-shell { width: min(100% - 1.5rem, 1240px); padding-top: 2.2rem; }
  .course-layout { grid-template-columns: 1fr; }
  .article-mode .page-shell { height: calc(100vh - 7.75rem); padding-top: 1rem; }
  .hero { margin-bottom: 2rem; padding-bottom: 2rem; }
  .card-grid { grid-template-columns: 1fr; }
  .course-sidebar { position: static; max-height: none; }
  .course-sidebar { display: flex; gap: .25rem; overflow-x: auto; padding: .45rem; }
  .course-sidebar h2 { display: none; }
  .course-sidebar a { flex: 0 0 auto; }
  .article { padding: 0 0 2rem; }
  .site-footer > * { width: min(100% - 1.5rem, 1240px); }
  .article-overview-item { grid-template-columns: 1fr; gap: .3rem; }
}
