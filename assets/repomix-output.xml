:root {
    /* font-main: 使用系統原生字體堆疊 (System Font Stack)
       優先順序：
       1. system-ui (瀏覽器自動選擇該系統最佳 UI 字體)
       2. -apple-system, BlinkMacSystemFont (macOS/iOS San Francisco)
       3. "Segoe UI" (Windows 預設)
       4. Roboto (Android 預設)
       5. "Helvetica Neue", Arial (通用無襯線)
       6. "Microsoft JhengHei" (微軟正黑體 - Windows 繁體中文)
       7. "PingFang TC" (蘋方 - macOS/iOS 繁體中文)
       8. sans-serif (最後防線)
    */
    --font-main: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Microsoft JhengHei", "PingFang TC", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    
    /* font-mono: 等寬字體系統堆疊 */
    --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}
