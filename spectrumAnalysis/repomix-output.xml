        function applyPreset(presetIndex) {
            document.querySelectorAll('.custom-dropdown-item').forEach((el, idx) => {
                el.classList.toggle('active', idx === presetIndex);
            });
            presetDropdownSelected.innerText = eqPresets[presetIndex].name;
